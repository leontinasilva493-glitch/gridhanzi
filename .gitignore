# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js
/.next/
/out/

# production
/build

# deploy
.vercel

# editors
.idea
.vscode
.cursor

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env — local files hold secrets, never commit (keep .env.example tracked)
.env
.env.*
!.env.example
!.env.production.example

# typescript
*.tsbuildinfo
next-env.d.ts

# database
/data/
/drizzle/
src/config/db/schema.ts

# npm (project uses pnpm)
package-lock.json

# vinext / vite build output
/dist/
/.vinext/
/.wrangler/
/worker/

# Cloudflare runtime secrets stay local; the production Wrangler config is
# tracked so Git-based deployments preserve bindings and routing behavior.
.env.production

# skills installed via `npx skills add` — keep project-owned skills tracked
/.agents/
/.claude/skills/migrate-to-vinext
skills-lock.json

# user-uploaded files from local dev (ticket attachments etc.)
public/uploads/

# local verification and research artifacts
/artifacts/
/output/
/tmp/

# local AI-agent instructions and internal implementation plans
/.claude/
/AGENTS.md
/CLAUDE.md
/docs/superpowers/
