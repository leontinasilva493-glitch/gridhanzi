# Public application settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=GridHanzi
NEXT_PUBLIC_APP_DESCRIPTION=Printable Chinese character practice sheets with Hanzi, Pinyin, tracing, and writing grids
NEXT_PUBLIC_APP_LOGO=/gridhanzi-icon-512.png
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Optional analytics
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js

# Optional worksheet enrichment. Without this key, the curated local
# vocabulary dictionary remains fully functional.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Public API protection knobs
WORKSHEET_MIN_INTERVAL_MS=2000
